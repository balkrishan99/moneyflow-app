# REQUIRED — signs and verifies login sessions. Generate one with:
#   openssl rand -base64 32
# Keep this secret. If it ever leaks, rotate it — that instantly invalidates
# every existing login session, including everyone else's.
JWT_SECRET=

# Optional — powers the "suggest category" AI button.
# Get a key from https://build.nvidia.com/
NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# REQUIRED — your MongoDB connection string. Set automatically if you add a
# MongoDB Atlas database from Vercel's Marketplace and connect it to this
# project (Vercel dashboard -> Storage -> Marketplace Database Providers ->
# MongoDB Atlas -> Connect Project). You normally never need to set this by
# hand.
# MONGODB_URI=
# MONGODB_DB_NAME=moneyflow

# Optional — powers the "suggest category" AI button. Without it, that
# button just shows a friendly error; everything else still works.
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
