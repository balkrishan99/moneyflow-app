# Required for persistence — MongoDB Atlas connection string
# Set this in Vercel Dashboard -> Project Settings -> Environment Variables
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=moneyflow

# Optional — powers the "suggest category" AI button.
# Get a key from https://build.nvidia.com/
NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.1-8b-instruct
